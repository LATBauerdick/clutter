
# ./update-json          everything: Discogs collection, folders, lists, wants, Tidal, Wikidata links
# ./update-json --tidal  Tidal only: favourites (cache/traw.json) and the album store,
#                        incl. the Apple Music lookup by UPC for albums not yet checked,
#                        then new Wikidata links
TIDAL_ONLY=
case "${1:-}" in
    --tidal) TIDAL_ONLY=1 ;;
    "") ;;
    *) echo "usage: ./update-json [--tidal]" >&2; exit 2 ;;
esac

# fresh Tidal token first (silent refresh; prints a login link only if the session is gone)
./tidalauth || echo "tidalauth failed -- Tidal fetch will use the old token" >&2

mkdir -p ./cache
cd ./cache
AMT=$(jq -r '.amt' ../tok.json)
TOK=$(jq -r '.tok' ../tok.json)
USR=$(jq -r '.usr' ../tok.json)
JKY=$(jq -r '.jky' ../tok.json)
TID=$(jq -r '.tid' ../tok.json)
TCC=$(jq -r '.tcc' ../tok.json)
TDT=$(jq -r '.tdt' ../tok.json)

#AMT=$(sed '1!d' ../tok.dat)
#TOK=$(sed '3!d' ../tok.dat)
#USR=$(sed '4!d' ../tok.dat)
#JKY=$(sed '5!d' ../tok.dat)
#TID=$(sed '6!d' ../tok.dat)
#TCC=$(sed '8!d' ../tok.dat)
#TDT=$(sed '9!d' ../tok.dat)

if [ -z "$TIDAL_ONLY" ]; then
echo $TOK
echo $USR
echo $JKY
echo $TID
echo $TCC
echo $TDT

# the collection in pages of 500, as many as Discogs says page 1 has (pagination.pages).
# The server reads draw1..draw4 always and draw5 if it is there; a page past the end is
# Discogs' "outside of valid range" message, which the scripts cannot read, so pages
# beyond the collection (from when it was bigger: 2,044 on 2026-11-01, 1,770 on 2026-11-27)
# are removed, from page 5 on.
curl "https://api.discogs.com/users/$USR/collection/folders/0/releases?page=1&per_page=500" -H "Authorization: Discogs token=$TOK"  > draw1.json
PAGES=$(jq -r '.pagination.pages // 4' draw1.json)
for P in $(seq 2 "$(( PAGES > 4 ? PAGES : 4 ))"); do
    curl "https://api.discogs.com/users/$USR/collection/folders/0/releases?page=$P&per_page=500" -H "Authorization: Discogs token=$TOK"  > "draw$P.json"
done
for F in draw*.json; do
    N=${F#draw}; N=${N%.json}
    if [ "$N" -gt 4 ] && [ "$N" -gt "$PAGES" ]; then rm -f "$F"; fi
done


curl "https://api.discogs.com/users/$USR/collection/folders" -H "Authorization: Discogs token=$TOK" > folders-raw.json

curl "https://api.discogs.com/users/$USR/lists" -H "Authorization: Discogs token=$TOK" > lists-raw.json
cat lists-raw.json | jq -r '.lists[] | {id} | join("\t")' > all-list-ids
for i in $(cat all-list-ids); do curl "https://api.discogs.com/lists/$i" -H "Authorization: Discogs token=$TOK" > l$i-raw.json; done

# Want list
curl "https://api.discogs.com/users/$USR/wants?page=1&per_page=500" -H "Authorization: Discogs token=$TOK" > wants1.json
fi

# Tidal
curl -H "Authorization: Bearer $TDT"  "https://api.tidalhifi.com/v1/users/$TID/favorites/albums/?countryCode=$TCC&limit=9999"  > traw.json
# clutter's Tidal album store (~/Sync/clutter/tidal-albums.json): keeps every album that was ever
# a favourite, so favourites can be deleted in the Tidal app; fetches played non-favourites
python3 ../scripts/update-tidal-albums.py

# Wikipedia/AllMusic links via Wikidata (~/Sync/clutter/wikidata.json), for Discogs masters and
# artists and the Tidal store's albums, Apple albums and artists; asks only new keys, rechecks
# by hand with --recheck (docs/wikidata-plan.md)
python3 ../scripts/update-wikidata.py

# Playing times of the Discogs releases the Tidal album store does not cover
# (~/Sync/clutter/album-lengths.json), for the length.* tags; asks only for new releases
python3 ../scripts/update-lengths.py

## Apple Music
####for i in {0..44}; do limit=100 ; ((off = $i*$limit)) ; curl -v -H "Authorization: Bearer $AMT" "https://api.music.apple.com/v1/me/library/albums?include=catalog&limit=$limit&offset=$off&sort=dateAdded" > am$i.json; done

cd ../
